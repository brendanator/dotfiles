#!/usr/bin/env bash
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/.dotfiles}"
MISE="$(command -v mise || echo "$HOME/.local/bin/mise")"

usage() {
  echo "Usage: dotfiles <apply|pull|push|sync-remotes|diff|status>"
  echo "  apply                  Link the configs into \$HOME (mise dot apply)"
  echo "  pull                   Pull latest changes, then apply"
  echo "  push                   Auto-commit and push local changes"
  echo "  sync-remotes [args...] Push, then mise bootstrap remote (default: --all"
  echo "                         hosts in mise.local.toml); args go to mise"
  echo "  diff                   Show uncommitted changes"
  echo "  status                 Show working tree status"
  exit 1
}

cmd_apply() {
  "$MISE" trust --quiet "$DOTFILES/mise.toml"
  "$MISE" -C "$DOTFILES" dotfiles apply --yes
}

cmd_pull() {
  cd "$DOTFILES"
  # Refuse rather than let the rebase trip over local edits.
  if ! git diff --quiet || ! git diff --cached --quiet; then
    echo "WARN: uncommitted changes in $DOTFILES; not pulling." >&2
    git status --short >&2
    echo "Run 'dotfiles push' to commit them, or 'dotfiles diff' to review." >&2
    exit 1
  fi
  git pull --rebase
  git submodule update --init --recursive
  cmd_apply
  # Stamp read by .zshrc's auto-pull; .state/ is gitignored so may not exist yet.
  mkdir -p .state
  date +%s > .state/last-pull
}

cmd_push() {
  cd "$DOTFILES"

  if ! git diff --quiet || ! git diff --cached --quiet; then
    git add -A
    git commit -m "Update dotfiles"
  fi

  # If the branch has no upstream (e.g. after a history rewrite dropped tracking),
  # push with -u to establish it. Don't treat a missing upstream as "nothing to push".
  if ! git rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
    branch="$(git branch --show-current)"
    echo "No upstream for '$branch'; pushing with -u."
    git push -u origin "$branch"
    return
  fi

  if [ -z "$(git rev-list '@{u}..HEAD')" ]; then
    echo "Nothing to push."
    return
  fi

  git push || {
    echo "Push failed, rebasing..."
    git pull --rebase
    git push
  }
}

cmd_sync_remotes() {
  # Each host fast-forwards its ~/.dotfiles clone from GitHub, so push first,
  # except for a dry run, which should change nothing.
  case " $* " in
    *" -n "*|*" --dry-run "*) ;;
    *) cmd_push ;;
  esac
  # Hosts come from [bootstrap.remote.hosts] in the gitignored mise.local.toml.
  if [ $# -eq 0 ]; then
    set -- --all
  fi
  "$MISE" -C "$DOTFILES" bootstrap remote "$@"
}

cmd_diff() {
  git -C "$DOTFILES" diff
}

cmd_status() {
  git -C "$DOTFILES" status
}

# Braces make bash parse to the final exit before running anything, so a pull
# that rewrites this file can't make it run on from the middle of the new one.
{
  case "${1:-}" in
    apply)        cmd_apply ;;
    pull)         cmd_pull ;;
    push)         cmd_push ;;
    sync-remotes) shift; cmd_sync_remotes "$@" ;;
    diff)         cmd_diff ;;
    status)       cmd_status ;;
    *)            usage ;;
  esac
  exit
}
