#!/usr/bin/env bash
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/.dotfiles}"

usage() {
  echo "Usage: dotfiles <pull|push|diff|status>"
  echo "  pull    Pull latest changes"
  echo "  push    Auto-commit and push local changes"
  echo "  diff    Show uncommitted changes"
  echo "  status  Show working tree status"
  exit 1
}

cmd_pull() {
  git -C "$DOTFILES" pull --rebase
  cd "$DOTFILES"
  for dir in */; do
    stow --adopt "$dir" 2>&1 || echo "WARN: failed to stow $dir"
  done
  git checkout .
}

cmd_push() {
  cd "$DOTFILES"

  if ! git diff --quiet || ! git diff --cached --quiet; then
    git add -A
    git commit -m "Update dotfiles"
  fi

  if [ -z "$(git log @{u}..HEAD 2>/dev/null)" ]; then
    echo "Nothing to push."
    return
  fi

  git push || {
    echo "Push failed, rebasing..."
    git pull --rebase
    git push
  }
}

cmd_diff() {
  git -C "$DOTFILES" diff
}

cmd_status() {
  git -C "$DOTFILES" status
}

case "${1:-}" in
  pull)    cmd_pull ;;
  push)    cmd_push ;;
  diff)    cmd_diff ;;
  status)  cmd_status ;;
  *)       usage ;;
esac
