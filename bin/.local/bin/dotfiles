#!/usr/bin/env bash
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/.dotfiles}"
# Gitignored, per-machine list of ssh hosts: one per line, '#' comments allowed.
REMOTES="$DOTFILES/remotes"
MISE="$(command -v mise || echo "$HOME/.local/bin/mise")"

usage() {
  echo "Usage: dotfiles <apply|pull|push|sync-remotes|diff|status>"
  echo "  apply                  Link the configs into \$HOME (mise dot apply)"
  echo "  pull                   Pull latest changes, then apply"
  echo "  push                   Auto-commit and push local changes"
  echo "  sync-remotes [host...] Push, then run 'dotfiles pull' on each remote"
  echo "                         (hosts default to the list in $REMOTES)"
  echo "  diff                   Show uncommitted changes"
  echo "  status                 Show working tree status"
  exit 1
}

# stow folded a directory it owned into a single symlink (e.g. ~/.claude/hooks), and
# mise refuses to write through one. Turn each such link back into a real directory,
# moving whatever untracked files the apps left in the repo through it (hosts.yml,
# .zsh_history, ...) out into that directory. Does nothing once no folded links remain.
unfold_stow_links() {
  local dir pkg rel link src f
  # Every directory above a tracked file, parents sorting before their children.
  git -C "$DOTFILES" ls-files | awk -F/ '{ d = $1; for (i = 2; i < NF; i++) { d = d "/" $i; print d } }' |
    sort -u | while IFS= read -r dir; do
    pkg="${dir%%/*}"
    rel="${dir#"$pkg"}"
    rel="${rel#/}"
    [ -n "$rel" ] || continue
    link="$HOME/$rel"
    src="$DOTFILES/$pkg/$rel"
    [ -L "$link" ] && [ -d "$link" ] || continue
    [ "$(cd "$link" && pwd -P)" = "$(cd "$src" && pwd -P)" ] || continue
    echo "Unfolding stow link ~/$rel"
    rm "$link"
    mkdir "$link"
    (cd "$src" && git ls-files --others .) | while IFS= read -r f; do
      mkdir -p "$(dirname "$link/$f")"
      mv "$src/$f" "$link/$f"
    done
  done

  # mise merges keys into ~/.claude/settings.json, so it must be a real file, not
  # stow's symlink to the repo copy.
  local settings="$HOME/.claude/settings.json"
  if [ -L "$settings" ] && [ "$(realpath "$settings")" = "$(realpath "$DOTFILES/claude/.claude/settings.json")" ]; then
    echo "Replacing stow link ~/.claude/settings.json with a copy"
    cp "$settings" "$settings.tmp"
    mv "$settings.tmp" "$settings"
  fi
}

cmd_apply() {
  unfold_stow_links
  "$MISE" trust --quiet "$DOTFILES/mise.toml"
  "$MISE" -C "$DOTFILES" dotfiles apply --yes
}

cmd_pull() {
  cd "$DOTFILES"
  # Refuse rather than let the rebase trip over local edits.
  if ! git diff --quiet || ! git diff --cached --quiet; then
    echo "WARN: uncommitted changes in $DOTFILES; not pulling." >&2
    git status --short >&2
    echo "Run 'dotfiles push' to commit them, or 'dotfiles diff' to review." >&2
    exit 1
  fi
  git pull --rebase
  git submodule update --init --recursive
  cmd_apply
  # Stamp read by .zshrc's auto-pull; .state/ is gitignored so may not exist yet.
  mkdir -p .state
  date +%s > .state/last-pull
}

cmd_push() {
  cd "$DOTFILES"

  if ! git diff --quiet || ! git diff --cached --quiet; then
    git add -A
    git commit -m "Update dotfiles"
  fi

  # If the branch has no upstream (e.g. after a history rewrite dropped tracking),
  # push with -u to establish it. Don't treat a missing upstream as "nothing to push".
  if ! git rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
    branch="$(git branch --show-current)"
    echo "No upstream for '$branch'; pushing with -u."
    git push -u origin "$branch"
    return
  fi

  if [ -z "$(git rev-list '@{u}..HEAD')" ]; then
    echo "Nothing to push."
    return
  fi

  git push || {
    echo "Push failed, rebasing..."
    git pull --rebase
    git push
  }
}

cmd_sync_remotes() {
  local hosts=("$@") host line
  if [ ${#hosts[@]} -eq 0 ]; then
    if [ ! -f "$REMOTES" ]; then
      echo "No remotes file. Add ssh hosts, one per line, to $REMOTES"
      exit 1
    fi
    while IFS= read -r line || [ -n "$line" ]; do
      line="${line%%#*}"
      line="$(echo $line)"
      [ -n "$line" ] && hosts+=("$line")
    done < "$REMOTES"
  fi
  if [ ${#hosts[@]} -eq 0 ]; then
    echo "No remotes listed in $REMOTES"
    exit 1
  fi

  cmd_push

  # Pull on all remotes in parallel, buffering output so hosts don't interleave.
  # A login shell gives the remote its usual PATH (mise, git, ~/.local/bin).
  local tmp pids=() failed=0 i
  tmp="$(mktemp -d)"
  for i in "${!hosts[@]}"; do
    ssh -n -o BatchMode=yes -o ConnectTimeout=10 "${hosts[$i]}" \
      'exec "$SHELL" -lc "PATH=\"\$HOME/.local/bin:\$PATH\" dotfiles pull"' \
      >"$tmp/$i" 2>&1 &
    pids+=($!)
  done
  for i in "${!hosts[@]}"; do
    if wait "${pids[$i]}"; then
      echo "✓ ${hosts[$i]}"
    else
      echo "✗ ${hosts[$i]}"
      failed=$((failed + 1))
    fi
    sed 's/^/    /' "$tmp/$i"
  done
  rm -rf "$tmp"

  if [ "$failed" -gt 0 ]; then
    echo "$failed of ${#hosts[@]} remotes failed."
    exit 1
  fi
}

cmd_diff() {
  git -C "$DOTFILES" diff
}

cmd_status() {
  git -C "$DOTFILES" status
}

# Braces make bash parse to the final exit before running anything, so a pull
# that rewrites this file can't make it run on from the middle of the new one.
{
  case "${1:-}" in
    apply)        cmd_apply ;;
    pull)         cmd_pull ;;
    push)         cmd_push ;;
    sync-remotes) shift; cmd_sync_remotes "$@" ;;
    diff)         cmd_diff ;;
    status)       cmd_status ;;
    *)            usage ;;
  esac
  exit
}
